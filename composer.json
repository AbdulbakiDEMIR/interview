{
	"name": "turkpin/interview-test",
	"autoload": {
		"psr-4": {
			"App\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests/"
		}
	},
	"authors": [
		{
			"name": "Turkpin DEV Team",
			"email": "devteam@turkpin.com"
		}
	],
	"require": {
		"smarty/smarty": "^5.0",
		"aura/router": "^3.3",
		"bramus/router": "^1.6",
		"vlucas/phpdotenv": "^5.6"
	},
	"require-dev": {
		"phpunit/phpunit": "^13.3",
		"phpstan/phpstan": "*",
		"friendsofphp/php-cs-fixer": "*"
	},
	"scripts": {
		"test": "vendor/bin/phpunit",
		"analyse": "vendor/bin/phpstan analyse src tests --level=5 --memory-limit=512M",
		"format": "vendor/bin/php-cs-fixer fix"
	}
}